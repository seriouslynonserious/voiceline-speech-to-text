# Generate distinct secrets with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_PASSWORD=replace-with-a-long-random-app-password
SPEECH_TOKEN=replace-with-a-long-random-internal-token
APP_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
WHISPER_MODEL=small
WHISPER_THREADS=4
MAX_STREAMS=2
# For cloud deployment, set APP_ORIGIN=https://your-domain.example,
# COOKIE_SECURE=true, and SITE_ADDRESS=your-domain.example.
SITE_ADDRESS=:80
